{
  "name": "Haskell Development Environment",
  "image": "ghcr.io/maybejustjames/llm-coding-workshop:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "haskell.haskell"
      ],
      "settings": {
        "haskell.manageHLS": "PATH",
        "haskell.serverExecutablePath": "/root/.ghcup/bin/haskell-language-server-wrapper"
      }
    }
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "runArgs": ["--security-opt=no-new-privileges"],
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
