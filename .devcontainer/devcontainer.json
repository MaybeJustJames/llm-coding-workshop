{
  "name": "Haskell Development Environment",
  "image": "ghcr.io/maybejustjames/llm-coding-workshop:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "haskell.haskell",
        "justusadam.language-haskell"
      ],
      "settings": {
        "haskell.plugin.ghcide.version": "9.6.7"
      }
    }
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "runArgs": ["--security-opt=no-new-privileges"],
  "postCreateCommand": "cabal update"
}
